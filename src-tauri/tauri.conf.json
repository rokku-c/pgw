{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Gateway",
  "version": "0.1.0",
  "identifier": "com.rokku-c.personal-gateway",
  "build": {
    "frontendDist": "./web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/pgw"],
    "category": "DeveloperTool",
    "shortDescription": "Local gateway for agent CLIs",
    "longDescription": "Personal Gateway proxies model providers locally and gives agent CLIs a shared console, MCP tools, and session memory."
  }
}
